#!/bin/sh
# ==============================================================================
# Pre-commit Hook: clang-format verification
# Automatically generated and configured by CMake
# ==============================================================================

CLANG_FORMAT="@CLANG_FORMAT_CMD@"

# If unconfigured or not found at configured path, fallback to 'clang-format' from PATH
if [ -z "$CLANG_FORMAT" ] || ! command -v "$CLANG_FORMAT" >/dev/null 2>&1; then
    if command -v clang-format >/dev/null 2>&1; then
        CLANG_FORMAT="clang-format"
    else
        echo "[pre-commit] WARNING: clang-format not found in PATH or CMake config."
        echo "[pre-commit] Skipping formatting verification."
        exit 0
    fi
fi

# Find all staged C/C++ source and header files (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cpp|h|hpp|c|cc|cxx)$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

HAS_FORMAT_ERRORS=0

for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" >/dev/null 2>&1; then
            echo "[pre-commit] ERROR: Clang-format style violation in: $FILE"
            HAS_FORMAT_ERRORS=1
        fi
    fi
done

if [ $HAS_FORMAT_ERRORS -ne 0 ]; then
    echo ""
    echo "======================================================================"
    echo "[pre-commit] COMMIT REJECTED: Code formatting violations detected."
    echo "[pre-commit] Fix violations using:"
    echo "    clang-format -i <file>"
    echo "  or from your CMake build directory:"
    echo "    cmake --build build --target format"
    echo "======================================================================"
    echo ""
    exit 1
fi

exit 0
