#!/bin/sh
# ==============================================================================
# Pre-commit Hook:
# 1. Merge conflict marker detection
# 2. Architectural boundary check (zero external dependencies in libs/ShooterCore)
# 3. IWYU & <cstdint> compliance check (scripts/verify_iwyu_cstdint.py)
# 4. clang-format style verification
# Automatically generated and configured by CMake
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Merge Conflict Marker Detection
# ------------------------------------------------------------------------------
ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$ALL_STAGED" ]; then
    HAS_CONFLICT_ERRORS=0
    for FILE in $ALL_STAGED; do
        if [ -f "$FILE" ]; then
            if grep -En '^(<{7}|={7}|>{7})( |$)' "$FILE" >/dev/null 2>&1; then
                echo "[pre-commit] ERROR: Merge conflict marker found in: $FILE"
                grep -En '^(<{7}|={7}|>{7})( |$)' "$FILE" | head -n 5
                HAS_CONFLICT_ERRORS=1
            fi
        fi
    done
    if [ $HAS_CONFLICT_ERRORS -ne 0 ]; then
        echo ""
        echo "======================================================================"
        echo "[pre-commit] COMMIT REJECTED: Unresolved merge conflicts found."
        echo "======================================================================"
        echo ""
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# 2. Architectural Boundary Check (libs/ShooterCore must be pure C++17)
# ------------------------------------------------------------------------------
CORE_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^libs/ShooterCore/.*\.(cpp|h|hpp)$')
if [ -n "$CORE_STAGED" ]; then
    HAS_ARCH_ERRORS=0
    for FILE in $CORE_STAGED; do
        if [ -f "$FILE" ]; then
            FORBIDDEN_MATCHES=$(grep -En '#\s*include\s*[<"](SDL|GL/|GL|Qt|windows\.h|sys/|unistd\.h)' "$FILE" 2>/dev/null)
            if [ -n "$FORBIDDEN_MATCHES" ]; then
                echo "[pre-commit] ERROR: Architectural boundary violation in: $FILE"
                echo "             libs/ShooterCore must maintain zero external dependencies."
                echo "             Forbidden include detected:"
                echo "$FORBIDDEN_MATCHES"
                HAS_ARCH_ERRORS=1
            fi
        fi
    done
    if [ $HAS_ARCH_ERRORS -ne 0 ]; then
        echo ""
        echo "======================================================================"
        echo "[pre-commit] COMMIT REJECTED: Core library architectural boundary violated."
        echo "======================================================================"
        echo ""
        exit 1
    fi
fi

# Find all staged C/C++ source and header files (Added, Copied, Modified, Renamed)
STAGED_CPP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cpp|h|hpp|c|cc|cxx)$')

if [ -z "$STAGED_CPP_FILES" ]; then
    exit 0
fi

# ------------------------------------------------------------------------------
# 3. IWYU and <cstdint> Compliance Verification
# ------------------------------------------------------------------------------
PYTHON_BIN="@PYTHON_CMD@"
if [ -z "$PYTHON_BIN" ] || ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="python3"
    elif command -v python >/dev/null 2>&1; then
        PYTHON_BIN="python"
    fi
fi

IWYU_SCRIPT=""
if [ -f "scripts/verify_iwyu_cstdint.py" ]; then
    IWYU_SCRIPT="scripts/verify_iwyu_cstdint.py"
elif [ -f ".agents/skills/iwyu-cstdint/scripts/verify_iwyu_cstdint.py" ]; then
    IWYU_SCRIPT=".agents/skills/iwyu-cstdint/scripts/verify_iwyu_cstdint.py"
fi

if [ -n "$PYTHON_BIN" ] && [ -n "$IWYU_SCRIPT" ]; then
    if ! "$PYTHON_BIN" "$IWYU_SCRIPT" --strict --files $STAGED_CPP_FILES; then
        echo ""
        echo "======================================================================"
        echo "[pre-commit] COMMIT REJECTED: <cstdint> or IWYU violation detected."
        echo "======================================================================"
        echo ""
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# 4. Clang-Format Verification
# ------------------------------------------------------------------------------
CLANG_FORMAT="@CLANG_FORMAT_CMD@"
if [ -z "$CLANG_FORMAT" ] || ! command -v "$CLANG_FORMAT" >/dev/null 2>&1; then
    if command -v clang-format >/dev/null 2>&1; then
        CLANG_FORMAT="clang-format"
    else
        echo "[pre-commit] WARNING: clang-format not found in PATH or CMake config."
        echo "[pre-commit] Skipping formatting verification."
        exit 0
    fi
fi

HAS_FORMAT_ERRORS=0
for FILE in $STAGED_CPP_FILES; do
    if [ -f "$FILE" ]; then
        if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" >/dev/null 2>&1; then
            echo "[pre-commit] ERROR: Clang-format style violation in: $FILE"
            HAS_FORMAT_ERRORS=1
        fi
    fi
done

if [ $HAS_FORMAT_ERRORS -ne 0 ]; then
    echo ""
    echo "======================================================================"
    echo "[pre-commit] COMMIT REJECTED: Code formatting violations detected."
    echo "[pre-commit] Fix violations using:"
    echo "    clang-format -i <file>"
    echo "  or from your CMake build directory:"
    echo "    cmake --build build --target format"
    echo "======================================================================"
    echo ""
    exit 1
fi

exit 0
